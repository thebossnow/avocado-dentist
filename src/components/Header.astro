---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/memberships/', label: 'Memberships' },
  { href: '/patient-info/', label: 'Patient Info' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100">
  <div class="container-max">
    <nav class="flex items-center justify-between h-16" aria-label="Main navigation">
      <a href="/" class="flex items-center" aria-label="Downtown Dental Studio of Fallbrook — Home">
        <picture>
          <source srcset="/images/logo-long.webp" type="image/webp">
          <img
            src="/images/logo-long.png"
            alt="Downtown Dental Studio of Fallbrook"
            class="h-10 w-auto"
            width="400"
            height="100"
          >
        </picture>
      </a>

      <div class="hidden lg:flex items-center gap-0.5">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-dental-700 
                   rounded-lg transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a href="tel:4423177000" class="ml-4 btn-primary !py-2 !px-5 !text-sm !rounded-full">
          (442) 317-7000
        </a>
      </div>

      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 text-gray-600 hover:text-dental-700"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>

    <div id="mobile-menu" class="hidden lg:hidden pb-4 border-t border-gray-100">
      <div class="flex flex-col gap-0.5 pt-3">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-3 py-3 text-base font-medium text-gray-700 hover:text-dental-700 
                   hover:bg-gray-50 rounded-lg transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a href="tel:4423177000" class="mt-3 btn-primary text-center !rounded-full">Call (442) 317-7000</a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu!.classList.contains('hidden');
    menu!.classList.toggle('hidden');
    iconOpen!.classList.toggle('hidden', isOpen);
    iconClose!.classList.toggle('hidden', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
