---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Downtown Dental Studio — General & Cosmetic Dentistry in Fallbrook, CA"
  description="Dr. Richard J Gill provides general, cosmetic, and emergency dentistry in Fallbrook, CA. Dental implants, Invisalign®, crowns, and VIP membership plans. Call (442) 317-7000."
  pageType="business"
>
  <!-- Hero -->
  <section class="container-max section">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-leaf-50 px-4 py-2 rounded-full text-sm font-medium text-leaf-700 mb-8">
        <span class="w-2 h-2 rounded-full bg-leaf-500 animate-pulse"></span>
        Now accepting new patients
      </div>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-dental-900 leading-[1.05] mb-6 text-balance">
        A dental experience<br/>
        <span class="text-dental-500">you'll actually enjoy</span>
      </h1>
      <p class="text-xl text-gray-500 leading-relaxed max-w-2xl mb-10">
        Dr. Richard J Gill and the Downtown Dental Studio team provide warm, 
        personalized dentistry in the heart of Fallbrook. No judgment, no pressure — 
        just exceptional care in a space that feels like home.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="tel:4423177000" class="btn-primary text-base px-8 py-4">
          Call (442) 317-7000
        </a>
        <a href="/contact/" class="btn-outline text-base px-8 py-4">
          Request Appointment
        </a>
      </div>
      <div class="flex items-center gap-8 mt-12 text-sm text-gray-400">
        <div class="flex items-center gap-2">
          <span class="text-lg">📍</span> 1180 S Main Ave, Fallbrook
        </div>
        <div class="flex items-center gap-2">
          <span class="text-lg">🕐</span> Mon–Fri 8am–5pm
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="border-y border-gray-100 bg-white">
    <div class="container-max py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-3xl font-bold text-dental-700">20+</p>
          <p class="text-sm text-gray-500 mt-1">Years of Experience</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-dental-700">5,000+</p>
          <p class="text-sm text-gray-500 mt-1">Happy Patients</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-dental-700">Same-Day</p>
          <p class="text-sm text-gray-500 mt-1">Emergency Visits</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-dental-700">$39/mo</p>
          <p class="text-sm text-gray-500 mt-1">VIP Memberships</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="container-max section">
    <div class="text-center mb-14">
      <p class="text-sm font-semibold text-leaf-600 uppercase tracking-widest mb-3">Our Services</p>
      <h2 class="text-4xl sm:text-5xl font-bold text-dental-900 mb-4 text-balance">Everything your smile needs</h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">From routine cleanings to full smile transformations — all under one roof in Fallbrook.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href="/services/general-dentistry/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-leaf-50 flex items-center justify-center mb-5 group-hover:bg-leaf-100 transition-colors">
          <svg class="w-6 h-6 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">General Dentistry</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Preventive care, exams, cleanings, and fillings for a lifetime of healthy smiles.</p>
      </a>
      <a href="/services/cosmetic-dentistry/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-leaf-50 flex items-center justify-center mb-5 group-hover:bg-leaf-100 transition-colors">
          <svg class="w-6 h-6 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">Cosmetic Dentistry</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Whitening, veneers, and smile makeovers designed around you.</p>
      </a>
      <a href="/services/dental-implants/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-leaf-50 flex items-center justify-center mb-5 group-hover:bg-leaf-100 transition-colors">
          <svg class="w-6 h-6 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-2.25-1.313M21 7.5v2.25m0-2.25-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3 2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75 2.25-1.313M12 21.75V19.5m0 2.25-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">Dental Implants</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Permanent tooth replacement that looks, feels, and functions naturally.</p>
      </a>
      <a href="/services/invisalign/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-leaf-50 flex items-center justify-center mb-5 group-hover:bg-leaf-100 transition-colors">
          <svg class="w-6 h-6 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">Invisalign®</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Clear aligners for a straighter smile — invisible, comfortable, effective.</p>
      </a>
      <a href="/services/root-canals-crowns/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-leaf-50 flex items-center justify-center mb-5 group-hover:bg-leaf-100 transition-colors">
          <svg class="w-6 h-6 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 9.75 21c-.72.2-1.48.18-2.25-.09a2.7 2.7 0 0 1-1.62-1.98c-.2-.8-.08-1.6.37-2.31l2.1-3.91m5.07 2.54L15.26 21c.72.2 1.48.18 2.25-.09a2.7 2.7 0 0 0 1.62-1.98c.2-.8.08-1.6-.37-2.31l-2.1-3.91M17 12.75A4.5 4.5 0 0 0 12.75 9V6.568a2.25 2.25 0 1 0-1.5 0V9A4.5 4.5 0 0 0 7 12.75"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">Crowns & Root Canals</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Restorative care to save and protect your natural teeth.</p>
      </a>
      <a href="/services/emergency-dentistry/" class="card-hover group">
        <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center mb-5 group-hover:bg-red-100 transition-colors">
          <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-dental-900 mb-2">Emergency Dentistry</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Same-day urgent care when you need it most. Don't wait in pain.</p>
      </a>
    </div>

    <div class="text-center mt-12">
      <a href="/services/" class="btn-outline">View All Services</a>
    </div>
  </section>

  <!-- Membership CTA -->
  <section class="bg-dental-900 text-white">
    <div class="container-max section">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-sm font-semibold text-warm-400 uppercase tracking-widest mb-4">No Insurance? No Problem</p>
        <h2 class="text-4xl sm:text-5xl font-bold mb-6 text-balance">Premium dental care,<br/>simple monthly pricing</h2>
        <p class="text-xl text-dental-200 leading-relaxed mb-10">
          Our VIP membership plans give you everything you need — cleanings, exams, X-rays, 
          and discounts on treatments — for one transparent monthly fee. No deductibles, 
          no waiting periods, no surprises.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/memberships/" class="btn-gold text-base px-8 py-4">
            Explore Plans
            <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
          <a href="tel:4423177000" class="btn inline-flex border-2 border-dental-500 text-dental-100 hover:bg-dental-800 hover:border-dental-400 text-base px-8 py-4 rounded-full">
            Call to Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us + Testimonials -->
  <section class="container-max section">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      <div>
        <p class="text-sm font-semibold text-leaf-600 uppercase tracking-widest mb-3">Why Downtown Dental</p>
        <h2 class="text-4xl font-bold text-dental-900 mb-8 text-balance">Care that puts you first</h2>
        <dl class="space-y-6">
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-leaf-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            </div>
            <div>
              <dt class="font-semibold text-dental-900">Personalized Treatment Plans</dt>
              <dd class="text-sm text-gray-500 mt-1">Every smile is unique. Dr. Gill creates a plan tailored to your goals, concerns, and budget — never a one-size-fits-all approach.</dd>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-leaf-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            </div>
            <div>
              <dt class="font-semibold text-dental-900">Transparent Pricing</dt>
              <dd class="text-sm text-gray-500 mt-1">You'll always know costs upfront — before treatment begins. VIP memberships, CareCredit, and Cherry financing available.</dd>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-leaf-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            </div>
            <div>
              <dt class="font-semibold text-dental-900">Same-Day Emergency Care</dt>
              <dd class="text-sm text-gray-500 mt-1">Dental pain can't wait. We reserve time daily for urgent cases — often seeing you the same day you call.</dd>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="w-10 h-10 rounded-xl bg-leaf-50 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-leaf-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            </div>
            <div>
              <dt class="font-semibold text-dental-900">Gentle, Judgment-Free Care</dt>
              <dd class="text-sm text-gray-500 mt-1">Anxious about the dentist? You're not alone. We create a calm, welcoming environment where you're always in control.</dd>
            </div>
          </div>
        </dl>
      </div>

      <div>
        <p class="text-sm font-semibold text-leaf-600 uppercase tracking-widest mb-3">Patient Stories</p>
        <h2 class="text-4xl font-bold text-dental-900 mb-8">What our patients say</h2>
        <div class="space-y-4">
          <div class="card">
            <div class="flex gap-1 mb-3 text-warm-500">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <p class="text-gray-700 leading-relaxed text-sm">"Dr. Gill and the team are incredible. I actually look forward to going to the dentist now. They take the time to explain everything and never make me feel rushed."</p>
            <p class="mt-3 text-xs font-semibold text-dental-700">Sarah M. · Fallbrook, CA</p>
          </div>
          <div class="card">
            <div class="flex gap-1 mb-3 text-warm-500">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            </div>
            <p class="text-gray-700 leading-relaxed text-sm">"I had a dental emergency and they got me in the same day. Professional, caring, and fast. The VIP membership makes dental care so affordable for my family."</p>
            <p class="mt-3 text-xs font-semibold text-dental-700">James T. · Bonsall, CA</p>
          </div>
        </div>
        <a href="https://share.google/2FymdENQzeRIspujS" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-dental-600 hover:text-dental-800 transition-colors">
          Read more reviews on Google
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Payment Options -->
  <section class="bg-white border-y border-gray-100">
    <div class="container-max py-14">
      <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
        <div class="text-center">
          <p class="font-semibold text-dental-800 text-sm">CareCredit</p>
          <p class="text-xs text-gray-400 mt-0.5">Healthcare Financing</p>
        </div>
        <div class="w-px h-8 bg-gray-200 hidden sm:block"></div>
        <div class="text-center">
          <p class="font-semibold text-dental-800 text-sm">Cherry</p>
          <p class="text-xs text-gray-400 mt-0.5">Buy Now, Pay Later</p>
        </div>
        <div class="w-px h-8 bg-gray-200 hidden sm:block"></div>
        <div class="text-center">
          <p class="font-semibold text-dental-800 text-sm">VIP Memberships</p>
          <p class="text-xs text-gray-400 mt-0.5">From $39/month</p>
        </div>
