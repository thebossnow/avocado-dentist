---
import Layout from '../layouts/Layout.astro';

const services = [
  { icon: '🦷', title: 'General Dentistry', href: '/services/general-dentistry/', desc: 'Preventive care, exams, cleanings, and fillings to keep your smile healthy.' },
  { icon: '✨', title: 'Cosmetic Dentistry', href: '/services/cosmetic-dentistry/', desc: 'Teeth whitening, veneers, and smile makeovers tailored to you.' },
  { icon: '🔩', title: 'Dental Implants', href: '/services/dental-implants/', desc: 'Permanent tooth replacement that looks and feels natural.' },
  { icon: '🦷', title: 'Invisalign®', href: '/services/invisalign/', desc: 'Clear aligners for a straighter smile without metal braces.' },
  { icon: '👑', title: 'Crowns & Root Canals', href: '/services/root-canals-crowns/', desc: 'Restorative care to save and protect damaged teeth.' },
  { icon: '🚨', title: 'Emergency Dentistry', href: '/services/emergency-dentistry/', desc: 'Same-day urgent care when you need it most.' },
];

const testimonials = [
  { text: 'Dr. Gill and his team are incredible. I actually look forward to going to the dentist now!', author: 'Maria S.', location: 'Fallbrook, CA' },
  { text: 'The VIP membership makes dental care so affordable for my family. Highly recommend Downtown Dental.', author: 'James T.', location: 'Fallbrook, CA' },
  { text: 'I had a dental emergency and they got me in the same day. Professional, caring, and fast.', author: 'Linda R.', location: 'Bonsall, CA' },
];
---

<Layout
  title="Downtown Dental Studio — Fallbrook's Trusted General & Cosmetic Dentist"
  description="Dr. Richard J Gill offers general, cosmetic, and emergency dentistry in Fallbrook, CA. Dental implants, Invisalign®, crowns, and VIP memberships. Call (442) 317-7000."
  pageType="business"
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-avocado-700 via-avocado-600 to-avocado-800 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 left-10 text-9xl transform -rotate-12">🥑</div>
      <div class="absolute bottom-10 right-10 text-8xl transform rotate-45">🦷</div>
    </div>
    <div class="container-max section-padding relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 backdrop-blur text-white px-4 py-1.5 rounded-full text-sm font-medium mb-6">
          🥑 Welcome to AvocadoDentist.com
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Your Smile,<br/><span class="text-gold-400">Naturally Beautiful</span>
        </h1>
        <p class="text-lg md:text-xl text-avocado-100 max-w-2xl mb-8 leading-relaxed">
          Dr. Richard J Gill and the Downtown Dental Studio team provide compassionate, 
          high-quality dental care in the heart of Fallbrook. From routine cleanings to 
          full smile transformations — we make every visit something to smile about.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:4423177000" class="btn-gold text-lg">
            📞 Call (442) 317-7000
          </a>
          <a href="/contact/" class="btn-secondary !border-white !text-white hover:!bg-white/10 text-lg">
            Book Your Visit
          </a>
        </div>
        <p class="mt-6 text-sm text-avocado-200">📍 1180 S Main Ave, Fallbrook, CA 92028 &nbsp;|&nbsp; 🕐 Mon–Fri 8am–5pm</p>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="bg-avocado-50 border-y border-avocado-200">
    <div class="container-max px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-3xl font-bold text-avocado-700 font-[family:var(--font-heading)]">20+</p>
          <p class="text-sm text-gray-600 mt-1">Years Experience</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-avocado-700 font-[family:var(--font-heading)]">5,000+</p>
          <p class="text-sm text-gray-600 mt-1">Happy Patients</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-avocado-700 font-[family:var(--font-heading)]">Same-Day</p>
          <p class="text-sm text-gray-600 mt-1">Emergency Care</p>
        </div>
        <div>
          <p class="text-3xl font-bold text-avocado-700 font-[family:var(--font-heading)]">VIP</p>
          <p class="text-sm text-gray-600 mt-1">Membership Plans</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="container-max section-padding">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-avocado-800 mb-4">Comprehensive Dental Care</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        From preventive care to advanced restorative treatments, we offer everything your family needs under one roof in Fallbrook.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(svc => (
        <a href={svc.href} class="card group hover:border-avocado-300 border border-transparent">
          <span class="text-4xl mb-4 block">{svc.icon}</span>
          <h3 class="text-xl font-semibold text-avocado-800 mb-2 font-[family:var(--font-heading)] group-hover:text-avocado-600 transition-colors">
            {svc.title}
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed">{svc.desc}</p>
          <span class="inline-block mt-3 text-avocado-600 text-sm font-medium group-hover:underline">
            Learn more →
          </span>
        </a>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/services/" class="btn-primary">View All Services</a>
    </div>
  </section>

  <!-- Membership CTA -->
  <section class="bg-gradient-to-r from-gold-400 to-gold-500">
    <div class="container-max px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block bg-white/30 backdrop-blur text-avocado-900 px-4 py-1.5 rounded-full text-sm font-semibold mb-4">
          💎 No Insurance? No Problem!
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-avocado-900 mb-4 font-[family:var(--font-heading)]">
          Join Our VIP Dental Membership
        </h2>
        <p class="text-lg text-avocado-800 mb-8">
          Get premium dental care at transparent, affordable prices. No deductibles, no waiting periods, 
          no surprises — just great dentistry with a plan that works for you.
        </p>
        <a href="/memberships/" class="inline-block px-10 py-4 bg-avocado-800 text-white font-bold rounded-lg
                   hover:bg-avocado-900 transition-all duration-200 shadow-lg hover:shadow-xl text-lg">
          Explore Membership Plans →
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-white">
    <div class="container-max section-padding">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-avocado-800 mb-6 font-[family:var(--font-heading)]">
            Why Fallbrook Chooses Downtown Dental Studio
          </h2>
          <ul class="space-y-4">
            <li class="flex gap-3">
              <span class="text-avocado-500 text-xl flex-shrink-0 mt-0.5">✓</span>
              <div>
                <h3 class="font-semibold text-gray-800">Personalized, Gentle Care</h3>
                <p class="text-gray-600 text-sm">Dr. Gill takes time to understand your goals and concerns. Every treatment plan is tailored to you.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="text-avocado-500 text-xl flex-shrink-0 mt-0.5">✓</span>
              <div>
                <h3 class="font-semibold text-gray-800">Advanced Technology</h3>
                <p class="text-gray-600 text-sm">Modern equipment for more accurate diagnoses, faster treatments, and better outcomes.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="text-avocado-500 text-xl flex-shrink-0 mt-0.5">✓</span>
              <div>
                <h3 class="font-semibold text-gray-800">Transparent Pricing & Financing</h3>
                <p class="text-gray-600 text-sm">VIP memberships, CareCredit, and Cherry financing — quality care that fits your budget.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="text-avocado-500 text-xl flex-shrink-0 mt-0.5">✓</span>
              <div>
                <h3 class="font-semibold text-gray-800">Emergency Appointments Available</h3>
                <p class="text-gray-600 text-sm">Dental pain doesn't wait. We offer same-day emergency care when you need it most.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="text-avocado-500 text-xl flex-shrink-0 mt-0.5">✓</span>
              <div>
                <h3 class="font-semibold text-gray-800">Convenient Fallbrook Location</h3>
                <p class="text-gray-600 text-sm">Right on S Main Ave — easy to find, plenty of parking, serving Fallbrook, Bonsall, and Rainbow.</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="bg-avocado-50 rounded-2xl p-8 border border-avocado-200">
          <h3 class="text-xl font-bold text-avocado-800 mb-6 font-[family:var(--font-heading)]">What Our Patients Say</h3>
          <div class="space-y-6">
            {testimonials.map(t => (
              <div class="bg-white p-5 rounded-xl shadow-sm">
                <p class="text-gray-700 italic leading-relaxed text-sm">"{t.text}"</p>
                <p class="mt-3 text-sm font-semibold text-avocado-700">{t.author} · {t.location}</p>
              </div>
            ))}
          </div>
          <a href="https://share.google/2FymdENQzeRIspujS" 
             target="_blank" rel="noopener" 
             class="block text-center mt-6 text-avocado-600 font-medium text-sm hover:underline">
            Read more reviews on Google →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Financing Badges -->
  <section class="bg-avocado-50">
    <div class="container-max px-4 sm:px-6 lg:px-8 py-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-avocado-800 font-[family:var(--font-heading)]">Payment Options That Work For You</h2>
      </div>
      <div class="flex flex-wrap justify-center items-center gap-8">
        <div class="bg-white rounded-lg px-6 py-3 shadow-sm text-center min-w-[140px]">
          <p class="font-bold text-gray-800 text-sm">CareCredit</p>
          <p class="text-xs text-gray-500">Healthcare Financing</p>
        </div>
        <div class="bg-white rounded-lg px-6 py-3 shadow-sm text-center min-w-[140px]">
          <p class="font-bold text-gray-800 text-sm">Cherry</p>
          <p class="text-xs text-gray-500">Buy Now, Pay Later</p>
        </div>
        <div class="bg-white rounded-lg px-6 py-3 shadow-sm text-center min-w-[140px]">
          <p class="font-bold text-gray-800 text-sm">VIP Memberships</p>
          <p class="text-xs text-gray-500">Starting at $39/mo</p>
        </div>
        <div class="bg-white rounded-lg px-6 py-3 shadow-sm text-center min-w-[140px]">
          <p class="font-bold text-gray-800 text-sm">PPO Plans</p>
          <p class="text-xs text-gray-500">Out-of-Network Benefits</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-avocado-800 text-white">
    <div class="container-max px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 font-[family:var(--font-heading)]">
        Ready to Love Your Smile?
      </h2>
      <p class="text-lg text-avocado-200 mb-8 max-w-2xl mx-auto">
        Schedule your appointment with Dr. Gill at Downtown Dental Studio. 
        New patients welcome — most insurance accepted.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="tel:4423177000" class="btn-gold text-lg">📞 Call (442) 317-7000</a>
        <a href="/contact/" class="btn-secondary !border-white !text-white hover:!bg-white/10 text-lg">
          Request Appointment
        </a>
      </div>
    </div>
  </section>
</Layout>
