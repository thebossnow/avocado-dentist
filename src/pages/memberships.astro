---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="VIP Dental Memberships | No Insurance? No Problem | Fallbrook"
  description="Downtown Dental Studio offers affordable dental membership plans through DentalHQ. Transparent pricing, no deductibles, no waiting periods. Join starting at $39/month."
  pageType="business"
>
  <section class="bg-gradient-to-br from-gold-400 to-gold-500">
    <div class="container-max section-padding text-center">
      <span class="inline-block bg-white/30 backdrop-blur text-avocado-900 px-4 py-1.5 rounded-full text-sm font-semibold mb-4">
        💎 VIP Dental Memberships
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-avocado-900 mb-4 font-[family:var(--font-heading)]">
        Quality Dental Care,<br/>Available for Everyone
      </h1>
      <p class="text-xl text-avocado-800 max-w-3xl mx-auto">
        No insurance? No problem. Our VIP membership plans make premium dental care accessible and affordable 
        for every member of your family.
      </p>
    </div>
  </section>

  <!-- What is it -->
  <section class="container-max section-padding">
    <h2 class="text-3xl font-bold text-avocado-800 mb-8 text-center font-[family:var(--font-heading)]">
      How It Works
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card text-center">
        <span class="text-5xl block mb-4">1️⃣</span>
        <h3 class="text-xl font-semibold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Choose Your Plan</h3>
        <p class="text-gray-600 text-sm">Select the membership that fits your needs — from basic preventive care to full coverage.</p>
      </div>
      <div class="card text-center">
        <span class="text-5xl block mb-4">2️⃣</span>
        <h3 class="text-xl font-semibold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Sign Up Online</h3>
        <p class="text-gray-600 text-sm">Quick and easy online enrollment through DentalHQ. No paperwork, no waiting periods.</p>
      </div>
      <div class="card text-center">
        <span class="text-5xl block mb-4">3️⃣</span>
        <h3 class="text-xl font-semibold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Start Smiling</h3>
        <p class="text-gray-600 text-sm">Schedule your first appointment and enjoy premium dental care at member prices immediately.</p>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-white">
    <div class="container-max section-padding">
      <h2 class="text-3xl font-bold text-avocado-800 mb-8 text-center font-[family:var(--font-heading)]">
        Membership Benefits
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        <div class="card text-center">
          <span class="text-4xl block mb-3">🛡️</span>
          <h3 class="font-semibold text-gray-800 mb-2">No Deductibles</h3>
          <p class="text-gray-600 text-sm">Pay only for what you need. No complicated deductibles to meet.</p>
        </div>
        <div class="card text-center">
          <span class="text-4xl block mb-3">⚡</span>
          <h3 class="font-semibold text-gray-800 mb-2">No Waiting Periods</h3>
          <p class="text-gray-600 text-sm">Get care immediately. Your coverage starts the day you sign up.</p>
        </div>
        <div class="card text-center">
          <span class="text-4xl block mb-3">💰</span>
          <h3 class="font-semibold text-gray-800 mb-2">Transparent Pricing</h3>
          <p class="text-gray-600 text-sm">Know exactly what you'll pay before any treatment begins.</p>
        </div>
        <div class="card text-center">
          <span class="text-4xl block mb-3">🎯</span>
          <h3 class="font-semibold text-gray-800 mb-2">No Annual Maximums</h3>
          <p class="text-gray-600 text-sm">Get the care you need without hitting coverage limits.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Plans Preview -->
  <section class="bg-avocado-50">
    <div class="container-max section-padding">
      <h2 class="text-3xl font-bold text-avocado-800 mb-8 text-center font-[family:var(--font-heading)]">
        Plan Options
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="card text-center border-2 border-transparent hover:border-avocado-300 transition-all">
          <h3 class="text-xl font-bold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Basic</h3>
          <p class="text-3xl font-bold text-avocado-600 mb-1">$39<span class="text-lg font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-4">Great for individuals</p>
          <ul class="text-sm text-gray-600 space-y-2 mb-6 text-left">
            <li>✅ 2 Cleanings / Year</li>
            <li>✅ 2 Exams / Year</li>
            <li>✅ X-Rays</li>
            <li>✅ 15% Off Treatments</li>
            <li>✅ Emergency Exams</li>
          </ul>
        </div>
        <div class="card text-center border-2 border-gold-500 relative">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-500 text-white text-xs font-bold px-3 py-1 rounded-full">MOST POPULAR</span>
          <h3 class="text-xl font-bold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Family</h3>
          <p class="text-3xl font-bold text-avocado-600 mb-1">$69<span class="text-lg font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-4">Best for families</p>
          <ul class="text-sm text-gray-600 space-y-2 mb-6 text-left">
            <li>✅ Everything in Basic</li>
            <li>✅ Covers Spouse + Kids</li>
            <li>✅ 20% Off Treatments</li>
            <li>✅ Free Whitening</li>
            <li>✅ Priority Scheduling</li>
          </ul>
        </div>
        <div class="card text-center border-2 border-transparent hover:border-avocado-300 transition-all">
          <h3 class="text-xl font-bold text-avocado-800 mb-2 font-[family:var(--font-heading)]">Premium</h3>
          <p class="text-3xl font-bold text-avocado-600 mb-1">$99<span class="text-lg font-normal text-gray-500">/mo</span></p>
          <p class="text-sm text-gray-500 mb-4">Complete coverage</p>
          <ul class="text-sm text-gray-600 space-y-2 mb-6 text-left">
            <li>✅ Everything in Family</li>
            <li>✅ 25% Off Treatments</li>
            <li>✅ Free Emergency Visits</li>
            <li>✅ Annual Oral Cancer Screening</li>
            <li>✅ Premium Concierge Service</li>
          </ul>
        </div>
      </div>
      <p class="text-center text-sm text-gray-500 mt-6">* Plans subject to change. View current options on DentalHQ for the most accurate pricing.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-avocado-800 text-white">
    <div class="container-max px-4 sm:px-6 lg:px-8 py-16 text-center">
      <h2 class="text-3xl font-bold mb-4 font-[family:var(--font-heading)]">Ready to Join?</h2>
      <p class="text-lg text-avocado-200 mb-8 max-w-2xl mx-auto">
        Enroll online in minutes through DentalHQ. View all plan details and choose the one that's right for you.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="https://app.dentalhq.com/accounts/signup/my-dentist/9803" 
           target="_blank" rel="noopener"
           class="btn-gold text-lg">
          Sign Up on DentalHQ →
        </a>
        <a href="tel:4423177000" class="btn-secondary !border-white !text-white hover:!bg-white/10 text-lg">
          Call to Learn More
        </a>
      </div>
    </div>
  </section>
</Layout>
