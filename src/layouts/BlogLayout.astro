---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description: string;
  date: string;
  category?: string;
}

const { title, description, date, category } = Astro.props;
---

<Layout
  title={title}
  description={description}
  pageType="blog"
  pageData={{ title, description, datePublished: date, dateModified: date }}
>
  <article class="container-max section-padding">
    <div class="max-w-3xl mx-auto">
      <header class="mb-12">
        {category && (
          <span class="text-xs font-medium text-avocado-600 bg-avocado-50 px-3 py-1 rounded-full inline-block mb-4">
            {category}
          </span>
        )}
        <h1 class="text-4xl md:text-5xl font-bold text-avocado-800 mb-4 font-[family:var(--font-heading)]">
          {title}
        </h1>
        <p class="text-xl text-gray-500 mb-4">{description}</p>
        <div class="flex items-center gap-3 text-sm text-gray-400">
          <time datetime={date}>
            {new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>·</span>
          <span>Downtown Dental Studio</span>
        </div>
      </header>

      <div class="prose prose-lg max-w-none prose-headings:text-avocado-800 prose-headings:font-[family:var(--font-heading)] prose-a:text-avocado-600">
        <slot />
      </div>

      <hr class="my-12 border-gray-200" />

      <div class="bg-avocado-50 rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold text-avocado-800 mb-2 font-[family:var(--font-heading)]">
          Ready to Schedule Your Visit?
        </h3>
        <p class="text-gray-600 mb-6">Dr. Gill and the Downtown Dental Studio team are here for you.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="tel:4423177000" class="btn-primary">📞 (442) 317-7000</a>
          <a href="/contact/" class="btn-secondary">Book Online</a>
        </div>
      </div>
    </div>
  </article>
</Layout>
